
!.env.example
# Build/release output
# Compiled binary
# Env / secrets
# Generated scan output (can land in any tool directory, including demo/*)
# Go
# OS / editor
# Test fixtures (generated, not meant to ship)
*.out
*.test
.DS_Store
.env
.env.*
.idea/
.vscode/
/autofix
/autofix.exe
/build/
/dist/
/testdata/
autofix-attestation.json
autofix-policy.yaml
autofix-session.json
autofix-session.patch
dist/

# MCP server: the bundle in mcp/dist is committed (installs run it), so it is
# exempt from the dist/ rule above
!mcp/dist/
mcp/server/node_modules/
mcp/*.tgz
